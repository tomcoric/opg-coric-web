DirectoryIndex index.html

# Bez ovoga .txt/.xml datoteke (llms.txt, humans.txt, robots.txt, sitemap.xml) šalju se
# bez charseta u Content-Type headeru, pa preglednici krivo nagađaju kodiranje i hrvatski
# dijakritici (Ć, Đ, č, š, ž) ispadnu kao mojibake.
AddDefaultCharset UTF-8

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [END,NE,R=301]

# Force www
RewriteCond %{HTTP_HOST} ^kulin-coric\.hr$ [NC]
RewriteRule ^ https://www.kulin-coric.hr%{REQUEST_URI} [END,NE,R=301]
